# 열람 게이트 · 질문/신고 위젯 설정값 템플릿
# 이 파일을 .env로 복사해 값을 채워 두고 개인 참고용으로 쓰세요. (.env는 커밋되지 않음)
#
# 주의: 이 프로젝트는 정적 사이트라 브라우저가 .env를 읽지 못합니다.
# 실제 반영 위치는 아래 두 곳입니다.
#   1) auth-config.js  — SUPABASE_URL / SUPABASE_ANON_KEY / ADMIN_EMAIL (커밋해서 배포)
#   2) supabase/*.sql  — RLS 정책의 관리자 이메일
# 절차는 ACCESS-SETUP.md 참고.

# Supabase — Settings → API
# 예: https://abcdefghijkl.supabase.co
SUPABASE_URL=

# anon public key — 공개되어도 되는 키 (권한은 RLS가 통제)
SUPABASE_ANON_KEY=

# 관리자(승인·질문신고 관리) 구글 계정
ADMIN_EMAIL=xxjjvxb@gmail.com

# service_role key — 지금 구조에서는 사용하지 않음.
# 나중에 서버 작업(일괄 승인 스크립트 등)에 쓰게 되면 여기에만 보관하고 절대 커밋·클라이언트 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud OAuth (Supabase Auth → Providers → Google에 입력)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
